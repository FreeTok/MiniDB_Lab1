Table datasets {
  id int [pk, increment]
  name varchar [not null]
  task varchar [not null]
  size int [not null]
}

Table models {
  id int [pk, increment]
  name varchar [not null]
  version varchar [not null]
}

Table experiments {
  id int [pk, increment]
  dataset_id int [not null, ref: > datasets.id]
  model_id int [not null, ref: > models.id]
  accuracy float [not null]
  status varchar [not null]
}
